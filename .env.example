# =============================================================================
# FILE: .env.example
# PURPOSE: Template for environment variables. Copy this file to .env.local
#          and fill in your real values. NEVER commit .env.local to Git.
#          Every secret here stays on the server — none go to the browser.
# =============================================================================

# --- SUPABASE ---
# Get these from: https://supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- CAPITAL STAKE API ---
# Main Bearer token — used for market data, quotes, screener, etc.
# SERVER ONLY — never expose to browser.
CAPITAL_STAKE_BEARER_TOKEN=your-capital-stake-bearer-token

CAPITAL_STAKE_BASE_URL=https://capital-stake-api-base-url

# Production: https://csapis.com
CAPITAL_STAKE_UAT_URL=https://csapis.com

# --- CAPITAL STAKE SSO (Broker Authentication) ---
# From the Stockifyy Integration document by Bilal Tariq
# Used to generate token-based login links for broker users
CAPITAL_STAKE_SSO_URL=https://capital-stake-sso-url
CAPITAL_STAKE_SSO_USERNAME=your-sso-username
CAPITAL_STAKE_SSO_PASSWORD=your-sso-password
CAPITAL_STAKE_CLIENT_ID=your-capital-stake-client-id

# --- UPSTASH REDIS (Cache Layer) ---
# Get these from: https://console.upstash.com → your Redis DB → REST API
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# --- CRON SECRET (protects /api/sync/* routes) ---
# Generate any random string: openssl rand -hex 32
CRON_SECRET=generate-with-openssl-rand-hex-32

# --- APP CONFIG ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Stockifyy

# --- SENTRY (Error Monitoring) ---
# Get this from: https://sentry.io → your project → Settings → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
