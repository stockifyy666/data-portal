# =============================================================================
# FILE: .gitignore
# PURPOSE: Tells Git which files to NEVER commit to the repository.
#          Most importantly — .env.local which contains all secrets.
# =============================================================================

# Environment files — NEVER commit these
.env.local
.env.*.local
.env.production

# Next.js build output
.next/
out/

# Node modules
node_modules/

# OS files
.DS_Store
Thumbs.db

# Debug logs
npm-debug.log*
yarn-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts
